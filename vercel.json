{
  "outputDirectory": "backend/admin",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "miniprogram/assets/videos/hailin-live.mp4"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/api/index"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/media/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/api/index"
    }
  ]
}
