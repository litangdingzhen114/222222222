.real-player-wrap {
  position: relative;
  height: 420rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #0A211F;
  box-shadow: 0 6rpx 18rpx rgba(26, 74, 70, 0.08);
}

.portrait-player-wrap {
  height: 1080rpx;
}

.real-player {
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 0;
  background: #0A211F;
}

.live-frame {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.live-scanline {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 8;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0) 32%, rgba(7, 27, 25, 0.16)),
    repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0, rgba(255, 255, 255, 0.05) 1rpx, transparent 1rpx, transparent 7rpx);
}

.live-time-badge {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  z-index: 24;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-width: 206rpx;
  height: 48rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  background: rgba(15, 79, 75, 0.86);
  color: #FBFFFC;
  line-height: 1;
  box-sizing: border-box;
  backdrop-filter: blur(8rpx);
}

.live-time-dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #D94B35;
}

.live-time-label {
  flex: 0 0 auto;
  margin-left: 10rpx;
  color: #FBFFFC;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.live-time-text {
  flex: 0 0 auto;
  margin-left: 10rpx;
  color: #FBFFFC;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.live-info-card {
  margin-top: 22rpx;
  padding: 26rpx;
}

.live-name {
  color: #193C3A;
  font-size: 34rpx;
  font-weight: 800;
}

.online {
  margin-top: 10rpx;
  color: #A7472D;
  font-size: 24rpx;
  font-weight: 800;
}

.live-desc {
  margin-top: 16rpx;
  color: #315A4E;
  font-size: 27rpx;
  line-height: 1.65;
}

.nearby-row {
  display: flex;
  gap: 18rpx;
}

.nearby-card {
  flex: 1;
  overflow: hidden;
}

.nearby-card-hover {
  opacity: 0.86;
  transform: translateY(2rpx);
}

.nearby-img {
  position: relative;
  overflow: hidden;
  height: 146rpx;
  border-radius: 16rpx 16rpx 0 0;
}

.nearby-img::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62%;
  background: linear-gradient(180deg, rgba(25, 60, 58, 0), rgba(25, 60, 58, 0.56));
}

.nearby-photo {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.nearby-img text {
  display: none;
}

.nearby-title {
  padding: 16rpx;
  color: #193C3A;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}
