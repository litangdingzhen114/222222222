<view wx:if="{{live}}" class="page live-detail-page page-pad">
  <view class="real-player-wrap portrait-player-wrap">
    <image class="real-player live-frame" src="{{liveFrameUrl}}" mode="aspectFill"></image>
    <view class="live-scanline"></view>
    <view class="live-time-badge">
      <view class="live-time-dot"></view>
      <view class="live-time-label">直播中</view>
      <view class="live-time-text">{{currentTime}}</view>
    </view>
  </view>

  <view class="live-info-card card">
    <view class="live-name">{{live.title}}</view>
    <view class="online">{{live.viewers}} 人正在观看</view>
    <view class="live-desc">{{live.desc}}</view>
  </view>

  <section-title title="周边推荐"></section-title>
  <view class="nearby-row">
    <view
      wx:for="{{nearby}}"
      wx:key="id"
      class="nearby-card card"
      hover-class="nearby-card-hover"
      data-url="{{item.targetUrl}}"
      bindtap="onNearbyTap"
    >
      <view class="nearby-img {{item.imageClass}}">
        <image wx:if="{{item.imageUrl}}" class="nearby-photo" src="{{item.imageUrl}}" mode="aspectFill"></image>
        <text wx:if="{{!item.imageUrl}}">{{item.icon}}</text>
      </view>
      <view class="nearby-title">{{item.title}}</view>
    </view>
  </view>
</view>
