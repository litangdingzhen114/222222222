.home-page {
  padding-bottom: 72rpx;
  background: #eef6f4;
}

.top-search {
  display: flex;
  align-items: center;
  gap: 110rpx;
  padding: 78rpx 34rpx 22rpx;
  background: #eef6f4;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #fbfffc;
  box-shadow: 0 8rpx 20rpx rgba(26, 74, 70, 0.06);
}

.search-icon {
  margin-right: 12rpx;
  color: #0f6b67;
  font-size: 34rpx;
  font-weight: 700;
}

.search-text {
  color: #607f7a;
  font-size: 29rpx;
}

.capsule-space {
  flex: 0 0 200rpx;
  height: 64rpx;
  border: 2rpx solid rgba(15, 107, 103, 0.1);
  border-radius: 999rpx;
  background: rgba(251, 255, 252, 0.66);
  box-shadow: 0 8rpx 20rpx rgba(26, 74, 70, 0.05);
}

.region-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-height: 58rpx;
  padding: 0 34rpx 18rpx;
  background: #eef6f4;
  color: #416a66;
  font-size: 22rpx;
}

.region-strip text:first-child {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.service-pill {
  flex: 0 0 auto;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #dcedea;
  color: #0f6b67;
  font-size: 20rpx;
  font-weight: 800;
}

.home-body {
  padding: 0 24rpx;
}

.banner-swiper {
  width: calc(100% + 48rpx);
  height: 520rpx;
  margin-left: -24rpx;
}

.banner-card {
  position: relative;
  height: 500rpx;
  overflow: hidden;
  border-radius: 0;
  color: #fbfffc;
  box-shadow: none;
}

.banner-card::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  background:
    linear-gradient(
      90deg,
      rgba(8, 43, 42, 0.76) 0%,
      rgba(8, 43, 42, 0.42) 48%,
      rgba(8, 43, 42, 0.14) 100%
    ),
    linear-gradient(0deg, rgba(8, 43, 42, 0.38), rgba(8, 43, 42, 0));
}

.banner-photo {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.banner-oujiang {
  background: #cfe4e2;
}

.banner-ricefish {
  background: #e8d9b7;
}

.banner-stone {
  background: #d6d0c4;
}

.banner-evening {
  background: #d7c7ac;
}

.banner-copy {
  position: relative;
  z-index: 2;
  width: 68%;
  padding: 66rpx 0 0 38rpx;
}

.banner-tag {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(15, 79, 75, 0.18);
  color: #fbfffc;
  font-size: 22rpx;
}

.banner-title {
  margin-top: 22rpx;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.15;
}

.banner-subtitle {
  margin-top: 14rpx;
  color: rgba(251, 255, 252, 0.9);
  font-size: 25rpx;
  line-height: 1.5;
}

.banner-art {
  position: absolute;
  z-index: 2;
  right: 10rpx;
  bottom: 0;
  width: 330rpx;
  height: 330rpx;
}

.art-sun {
  position: absolute;
  top: 4rpx;
  right: 34rpx;
  width: 102rpx;
  height: 102rpx;
  border-radius: 50%;
  background: rgba(251, 255, 252, 0.5);
}

.art-mountain {
  position: absolute;
  bottom: 50rpx;
  width: 270rpx;
  height: 180rpx;
  border-radius: 140rpx 140rpx 0 0;
  background: rgba(251, 255, 252, 0.28);
}

.art-mountain.one {
  right: 66rpx;
}

.art-mountain.two {
  right: -52rpx;
  bottom: 28rpx;
  background: rgba(15, 79, 75, 0.16);
}

.art-house {
  position: absolute;
  right: 68rpx;
  bottom: 28rpx;
  width: 138rpx;
  height: 86rpx;
  border-radius: 16rpx 16rpx 8rpx 8rpx;
  background: rgba(251, 255, 252, 0.78);
}

.art-word {
  display: none;
}

.notice-card {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  min-height: 96rpx;
  margin: -24rpx 0 0;
  padding: 0 30rpx;
  border-radius: 36rpx 36rpx 0 0;
  background: #e2f0ec;
  box-shadow: 0 -8rpx 24rpx rgba(26, 74, 70, 0.04);
}

.notice-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: transparent;
  color: #0f6b67;
  font-size: 24rpx;
  font-weight: 800;
}

.notice-text {
  flex: 1;
  color: #315a4e;
  font-size: 25rpx;
  line-height: 1.35;
}

.grid-panel {
  padding: 16rpx 14rpx 28rpx;
  border-radius: 0 0 36rpx 36rpx;
  background: #e2f0ec;
  box-shadow: none;
}

.grid-swiper {
  height: 438rpx;
}

.grid-wrap {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  row-gap: 30rpx;
  padding-top: 12rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.grid-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  margin-bottom: 12rpx;
  border-radius: 0;
  background: transparent;
  color: #0f4f4b;
  font-size: 25rpx;
  font-weight: 900;
  box-shadow: none;
}

.grid-icon-img {
  width: 64rpx;
  height: 64rpx;
}

.grid-text {
  max-width: 112rpx;
  color: #315a4e;
  font-size: 23rpx;
  line-height: 1.22;
  text-align: center;
}

.grid-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 4rpx;
}

.grid-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #bfd9d3;
}

.grid-dot.active {
  width: 28rpx;
  border-radius: 999rpx;
  background: #0f6b67;
}

.weather-strip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  width: calc(100% + 48rpx);
  margin: 26rpx 0 0 -24rpx;
  border-radius: 0;
  background: linear-gradient(
    90deg,
    rgba(226, 240, 236, 0),
    #dcedea 18%,
    #dcedea 82%,
    rgba(226, 240, 236, 0)
  );
  color: #0f4f4b;
  font-size: 30rpx;
  font-weight: 600;
}

.hot-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.hot-card {
  position: relative;
  min-height: 230rpx;
  overflow: hidden;
  padding: 26rpx 24rpx;
  border-radius: 20rpx;
  color: #fbfffc;
  box-shadow: 0 14rpx 32rpx rgba(26, 74, 70, 0.12);
}

.hot-card::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  background: linear-gradient(
    135deg,
    rgba(15, 79, 75, 0.74),
    rgba(15, 79, 75, 0.18)
  );
}

.hot-photo,
.ranking-photo,
.corridor-photo,
.feed-photo {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.recommend-guide {
  background: #cfe4e2;
}

.recommend-drama {
  background: #d6d0c4;
}

.recommend-family {
  background: #e8d9b7;
}

.recommend-hotel {
  background: #d7c7ac;
}

.recommend-food {
  background: #e7c79d;
}

.recommend-live {
  background: #bfd9d3;
}

.hot-copy {
  position: relative;
  z-index: 2;
}

.hot-title {
  font-size: 34rpx;
  font-weight: 800;
}

.hot-subtitle {
  width: 210rpx;
  margin-top: 10rpx;
  color: rgba(251, 255, 252, 0.88);
  font-size: 27rpx;
  line-height: 1.35;
}

.hot-more {
  display: inline-flex;
  margin-top: 20rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(251, 255, 252, 0.78);
  color: #0f4f4b;
  font-size: 23rpx;
  font-weight: 700;
}

.hot-illus {
  display: none;
}

.itinerary-scroll {
  width: 100%;
  white-space: nowrap;
}

.itinerary-row {
  display: flex;
  gap: 18rpx;
}

.itinerary-card {
  position: relative;
  width: 560rpx;
  height: 332rpx;
  flex: 0 0 560rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: #123330;
  color: #fbfffc;
  box-shadow: 0 14rpx 32rpx rgba(26, 74, 70, 0.12);
}

.itinerary-photo,
.itinerary-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.itinerary-mask {
  background:
    linear-gradient(
      90deg,
      rgba(18, 51, 48, 0.84) 0%,
      rgba(18, 51, 48, 0.54) 54%,
      rgba(18, 51, 48, 0.18) 100%
    ),
    linear-gradient(0deg, rgba(18, 51, 48, 0.42), rgba(18, 51, 48, 0));
}

.itinerary-copy {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  min-height: 100%;
  padding: 28rpx;
}

.itinerary-label {
  align-self: flex-start;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(251, 255, 252, 0.18);
  color: #e2f0ec;
  font-size: 21rpx;
  font-weight: 800;
}

.itinerary-title {
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.18;
}

.itinerary-time {
  margin-top: 8rpx;
  color: #f0c76d;
  font-size: 24rpx;
  font-weight: 800;
}

.itinerary-route {
  width: 390rpx;
  margin-top: 12rpx;
  color: rgba(251, 255, 252, 0.9);
  font-size: 24rpx;
  line-height: 1.45;
  white-space: normal;
}

.itinerary-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: auto;
}

.itinerary-tags text {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(251, 255, 252, 0.76);
  color: #0f4f4b;
  font-size: 20rpx;
  font-weight: 800;
}

.service-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(15, 107, 103, 0.1);
  border-radius: 28rpx;
  background:
    linear-gradient(135deg, rgba(251, 255, 252, 0.92) 0%, rgba(238, 247, 243, 0.92) 100%);
  box-shadow: 0 12rpx 28rpx rgba(26, 74, 70, 0.06);
}

.service-card {
  position: relative;
  display: flex;
  min-height: 132rpx;
  padding: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(15, 107, 103, 0.1);
  border-radius: 22rpx;
  background: rgba(251, 255, 252, 0.72);
  box-shadow: none;
  transition: opacity 180ms ease, transform 180ms ease;
}

.service-card-0 {
  grid-column: 1 / 3;
  min-height: 166rpx;
  padding: 24rpx;
  border-color: rgba(200, 156, 63, 0.28);
  background:
    linear-gradient(135deg, rgba(255, 249, 238, 0.94) 0%, rgba(239, 249, 245, 0.96) 100%);
  box-shadow: 0 12rpx 26rpx rgba(26, 74, 70, 0.08);
}

.service-card-hover {
  opacity: 0.9;
  transform: translateY(2rpx);
}

.service-card-0::after {
  content: "";
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(200, 156, 63, 0.62), rgba(200, 156, 63, 0));
}

.service-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 54rpx;
  margin-right: 14rpx;
  border-radius: 16rpx;
  background: #e8f5f1;
  color: #0f4f4b;
  font-size: 21rpx;
  font-weight: 900;
}

.service-card-0 .service-icon {
  flex-basis: 68rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #dcedea;
}

.service-icon-img {
  width: 34rpx;
  height: 34rpx;
}

.service-card-0 .service-icon-img {
  width: 42rpx;
  height: 42rpx;
}

.service-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.service-title-row {
  display: flex;
  align-items: center;
}

.service-title {
  overflow: hidden;
  color: #193c3a;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.service-card-0 .service-title {
  font-size: 32rpx;
}

.service-status {
  margin-bottom: 6rpx;
  color: #7a9691;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
}

.service-card-0 .service-status {
  color: #9a6b20;
}

.service-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 9rpx;
  color: #4f716a;
  font-size: 21rpx;
  line-height: 1.48;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.service-card-0 .service-desc {
  width: 430rpx;
  font-size: 24rpx;
  -webkit-line-clamp: 2;
}

.service-action {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: flex-end;
  min-width: 42rpx;
  height: 42rpx;
  margin-top: auto;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(15, 107, 103, 0.08);
  color: #0f6b67;
  font-size: 21rpx;
  font-weight: 900;
}

.service-card-0 .service-action {
  align-self: flex-start;
  height: 50rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
  background: #0f6b67;
  color: #ffffff;
}

.service-arrow {
  margin-left: 6rpx;
  font-size: 26rpx;
  line-height: 1;
}

.product-panel {
  padding: 28rpx 26rpx 30rpx;
  border-radius: 24rpx;
  border: 2rpx solid #dcedea;
  background: #fbfffc;
}

.product-title-main {
  color: #a7472d;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.25;
}

.product-sub {
  margin-top: 8rpx;
  color: #607f7a;
  font-size: 24rpx;
  line-height: 1.4;
}

.product-scroll {
  width: 100%;
  margin-top: 22rpx;
  white-space: nowrap;
}

.product-row {
  display: flex;
  gap: 18rpx;
}

.ranking-scroll,
.corridor-scroll {
  width: 100%;
  white-space: nowrap;
}

.ranking-row {
  display: flex;
  gap: 18rpx;
}

.ranking-card {
  width: 430rpx;
  flex: 0 0 430rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #dcedea;
  box-shadow: none;
}

.ranking-title {
  color: #193c3a;
  font-size: 34rpx;
  font-weight: 800;
}

.ranking-tabs {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}

.ranking-tabs text {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fbfffc;
  color: #0f6b67;
  font-size: 20rpx;
}

.ranking-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.ranking-img {
  position: relative;
  height: 126rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.ranking-img::after,
.corridor-img::after,
.feed-img::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62%;
  background: linear-gradient(
    180deg,
    rgba(25, 60, 58, 0),
    rgba(25, 60, 58, 0.58)
  );
}

.ranking-img-word {
  display: none;
}

.ranking-img-title {
  position: absolute;
  z-index: 2;
  left: 16rpx;
  bottom: 12rpx;
  color: #fbfffc;
  font-size: 24rpx;
  font-weight: 700;
}

.corridor-row {
  display: flex;
  gap: 18rpx;
}

.corridor-card {
  width: 230rpx;
  flex: 0 0 230rpx;
}

.corridor-img {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  width: 230rpx;
  height: 178rpx;
  overflow: hidden;
  padding: 16rpx;
  border-radius: 26rpx;
}

.corridor-img text {
  display: none;
}

.corridor-title {
  margin-top: 12rpx;
  color: #193c3a;
  font-size: 26rpx;
  font-weight: 700;
}

.feed-waterfall {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.feed-col {
  flex: 1;
  min-width: 0;
}

.feed-card {
  overflow: hidden;
  margin-bottom: 18rpx;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 18rpx rgba(26, 74, 70, 0.04);
}

.feed-img {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  height: 270rpx;
  padding: 18rpx;
  border-radius: 12rpx 12rpx 0 0;
}

.feed-col:nth-child(2) .feed-card:nth-child(2n) .feed-img {
  height: 280rpx;
}

.feed-img text {
  display: none;
}

.feed-title {
  padding: 18rpx 18rpx 0;
  color: #193c3a;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.35;
}

.feed-user {
  padding: 10rpx 18rpx 20rpx;
  color: #607f7a;
  font-size: 22rpx;
}
