.mine-feature-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 140rpx;
  box-sizing: border-box;
  background: #EEF6F4;
}

.feature-hero {
  position: relative;
  min-height: 360rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #FBFFFC;
  box-shadow: 0 10rpx 28rpx rgba(26, 74, 70, 0.08);
}

.feature-hero-img {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.feature-hero-shade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(20, 54, 50, 0.08), rgba(10, 42, 39, 0.68));
}

.feature-hero-copy {
  position: relative;
  z-index: 1;
  display: flex;
  min-height: 360rpx;
  flex-direction: column;
  justify-content: flex-end;
  padding: 32rpx;
  box-sizing: border-box;
  color: #FBFFFC;
}

.hero-tag {
  align-self: flex-start;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(251, 255, 252, 0.88);
  color: #0F6B67;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.feature-title {
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 900;
  letter-spacing: 0;
  line-height: 1.2;
}

.feature-subtitle {
  margin-top: 12rpx;
  max-width: 620rpx;
  font-size: 25rpx;
  line-height: 1.55;
  opacity: 0.92;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.hero-chip {
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(251, 255, 252, 0.18);
  color: #FBFFFC;
  font-size: 21rpx;
  line-height: 40rpx;
}

.style-market .feature-hero-shade {
  background: linear-gradient(180deg, rgba(68, 41, 20, 0.06), rgba(71, 38, 22, 0.72));
}

.style-stay .feature-hero-shade,
.style-venue .feature-hero-shade {
  background: linear-gradient(180deg, rgba(30, 57, 52, 0.04), rgba(38, 58, 46, 0.7));
}

.style-study .feature-hero-shade,
.style-guide .feature-hero-shade {
  background: linear-gradient(180deg, rgba(16, 63, 65, 0.08), rgba(13, 72, 69, 0.72));
}

.style-ticket .feature-hero-shade,
.style-route .feature-hero-shade,
.style-team .feature-hero-shade {
  background: linear-gradient(180deg, rgba(57, 77, 52, 0.06), rgba(44, 64, 38, 0.7));
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 34rpx 4rpx 16rpx;
  color: #193C3A;
  font-size: 31rpx;
  font-weight: 900;
}

.section-meta {
  flex-shrink: 0;
  color: #607F7A;
  font-size: 23rpx;
  font-weight: 700;
}

.scene-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.scene-stat {
  min-height: 96rpx;
  padding: 18rpx 10rpx;
  border-radius: 14rpx;
  background: #FBFFFC;
  box-sizing: border-box;
  text-align: center;
}

.scene-stat text:first-child {
  display: block;
  color: #607F7A;
  font-size: 21rpx;
  font-weight: 700;
}

.scene-stat text:last-child {
  display: block;
  margin-top: 8rpx;
  color: #193C3A;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.25;
}

.mood-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 24rpx;
  border: 2rpx solid #DCEDEA;
  border-radius: 18rpx;
  background: #FBFFFC;
}

.mood-mark {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #F5E8D0;
  color: #8A5E23;
  font-size: 21rpx;
  font-weight: 900;
}

.mood-copy {
  min-width: 0;
  color: #315A4E;
  font-size: 25rpx;
  line-height: 1.55;
}

.feature-highlight-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.feature-highlight-card {
  min-height: 154rpx;
  padding: 22rpx;
  border: 2rpx solid #DCEDEA;
  border-radius: 16rpx;
  background: #FBFFFC;
  box-sizing: border-box;
}

.style-venue .feature-highlight-grid,
.style-team .feature-highlight-grid {
  grid-template-columns: 1fr;
}

.style-guide .feature-highlight-card,
.style-study .feature-highlight-card,
.style-ticket .feature-highlight-card {
  border-left: 8rpx solid #1D7C78;
}

.style-market .feature-highlight-card {
  border-color: #EAD8BA;
  background: #FFFCF6;
}

.feature-highlight-title {
  color: #193C3A;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.3;
}

.feature-highlight-desc {
  margin-top: 10rpx;
  color: #607F7A;
  font-size: 23rpx;
  line-height: 1.45;
}

.choice-rail {
  width: 100%;
  white-space: nowrap;
}

.choice-row {
  display: flex;
  gap: 16rpx;
  padding: 2rpx 2rpx 8rpx;
}

.choice-card {
  position: relative;
  display: inline-flex;
  width: 430rpx;
  min-height: 320rpx;
  overflow: hidden;
  flex-direction: column;
  border: 3rpx solid transparent;
  border-radius: 18rpx;
  background: #FBFFFC;
  box-shadow: 0 8rpx 24rpx rgba(26, 74, 70, 0.08);
}

.choice-card.active {
  border-color: #0F6B67;
}

.choice-card.active::after {
  content: "";
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  width: 22rpx;
  height: 22rpx;
  border: 6rpx solid #FBFFFC;
  border-radius: 50%;
  background: #0F6B67;
  box-shadow: 0 0 0 2rpx #0F6B67;
}

.choice-photo {
  width: 100%;
  height: 156rpx;
  background: #DCEDEA;
}

.style-market .choice-card {
  width: 356rpx;
  min-height: 370rpx;
}

.style-market .choice-photo {
  height: 190rpx;
}

.style-stay .choice-card,
.style-venue .choice-card {
  width: 520rpx;
  min-height: 348rpx;
  border-radius: 22rpx;
}

.style-stay .choice-photo,
.style-venue .choice-photo {
  height: 180rpx;
}

.style-route .choice-card,
.style-team .choice-card {
  width: 480rpx;
  min-height: 298rpx;
}

.style-guide .choice-card,
.style-study .choice-card,
.style-ticket .choice-card {
  width: 410rpx;
}

.choice-body {
  padding: 20rpx;
  box-sizing: border-box;
}

.choice-title,
.coupon-title,
.task-title,
.record-title {
  color: #193C3A;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
  white-space: normal;
}

.choice-desc,
.coupon-desc,
.task-desc,
.record-desc,
.checkin-desc,
.points-note,
.request-lead {
  margin-top: 8rpx;
  color: #607F7A;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: normal;
}

.choice-price {
  margin-top: 16rpx;
  color: #A7472D;
  font-size: 27rpx;
  font-weight: 900;
}

.service-flow-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: #FBFFFC;
}

.style-route .service-flow-card,
.style-team .service-flow-card {
  border-left: 10rpx solid #C89C3F;
}

.style-stay .service-flow-card,
.style-venue .service-flow-card {
  background: #F8FBF5;
}

.service-flow-title,
.service-note-title,
.request-title {
  color: #0F6B67;
  font-size: 30rpx;
  font-weight: 900;
}

.flow-step {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 22rpx;
  color: #315A4E;
  font-size: 25rpx;
  line-height: 1.5;
}

.flow-index {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #DCEDEA;
  color: #0F6B67;
  font-size: 23rpx;
  font-weight: 900;
}

.flow-copy {
  flex: 1;
}

.request-panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: #FBFFFC;
  box-shadow: 0 10rpx 26rpx rgba(26, 74, 70, 0.08);
}

.request-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.request-price {
  flex-shrink: 0;
  color: #A7472D;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.4;
}

.selected-summary {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #EEF6F4;
}

.selected-title {
  color: #193C3A;
  font-size: 31rpx;
  font-weight: 900;
}

.selected-sub {
  margin-top: 8rpx;
  color: #607F7A;
  font-size: 24rpx;
}

.compact-fields {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.compact-field {
  min-height: 104rpx;
  padding: 18rpx;
  border: 2rpx solid #DCEDEA;
  border-radius: 14rpx;
  background: #FBFFFC;
  box-sizing: border-box;
}

.compact-field text:first-child {
  display: block;
  color: #607F7A;
  font-size: 22rpx;
  font-weight: 700;
}

.compact-field text:last-child {
  display: block;
  margin-top: 10rpx;
  color: #193C3A;
  font-size: 26rpx;
  font-weight: 900;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.step-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 12rpx;
  background: #DCEDEA;
  color: #0F6B67;
  font-size: 30rpx;
  font-weight: 900;
}

.step-value {
  min-width: 48rpx;
  color: #193C3A;
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
}

.form-input,
.form-textarea {
  width: 100%;
  margin-top: 18rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #EEF6F4;
  color: #193C3A;
  font-size: 27rpx;
  box-sizing: border-box;
}

.form-input {
  height: 82rpx;
}

.code-input {
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.form-textarea {
  min-height: 190rpx;
  padding-top: 20rpx;
  line-height: 1.5;
}

.form-textarea.small {
  min-height: 136rpx;
}

.form-placeholder {
  color: #8EA6A0;
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin-top: 24rpx;
  border-radius: 14rpx;
  background: #0F6B67;
  color: #FBFFFC;
  font-size: 29rpx;
  font-weight: 900;
  box-shadow: none;
}

.primary-action[disabled] {
  background: #BFD9D3;
  color: #607F7A;
}

.style-market .primary-action,
.style-market .service-flow-title,
.style-market .request-title {
  background-color: #A7472D;
}

.style-market .service-flow-title,
.style-market .request-title {
  background: none;
  color: #8A4A2A;
}

.style-market .hero-tag,
.style-market .choice-card.active {
  color: #8A4A2A;
}

.service-note-card {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #F9F2E6;
}

.service-note-item {
  position: relative;
  margin-top: 14rpx;
  padding-left: 24rpx;
  color: #5B422B;
  font-size: 24rpx;
  line-height: 1.5;
}

.service-note-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #C89C3F;
}

.coupon-list,
.task-list,
.record-list {
  display: grid;
  gap: 18rpx;
}

.choice-card,
.coupon-card,
.task-card,
.record-item,
.points-panel,
.checkin-panel {
  background: #FBFFFC;
}

.coupon-card,
.task-card,
.record-item,
.points-panel,
.checkin-panel {
  padding: 26rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 22rpx rgba(26, 74, 70, 0.06);
}

.coupon-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.coupon-card.disabled {
  opacity: 0.55;
}

.coupon-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

.coupon-amount {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  margin-right: 20rpx;
  border-radius: 14rpx;
  background: #F4D58E;
  color: #193C3A;
  font-size: 28rpx;
  font-weight: 900;
}

.coupon-info {
  min-width: 0;
}

.mini-btn,
.coupon-status {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 118rpx;
  height: 58rpx;
  border-radius: 12rpx;
  background: #1D7C78;
  color: #FBFFFC;
  font-size: 24rpx;
  font-weight: 800;
}

.mini-btn.outline,
.coupon-status {
  border: 2rpx solid #BFD9D3;
  background: #FBFFFC;
  color: #0F6B67;
}

.points-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.points-label {
  color: #607F7A;
  font-size: 24rpx;
  font-weight: 700;
}

.points-value {
  margin-top: 8rpx;
  color: #0F6B67;
  font-size: 58rpx;
  font-weight: 900;
}

.points-note {
  width: 330rpx;
  text-align: right;
}

.task-card,
.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.task-card.done {
  background: #F3FBF9;
}

.task-points {
  flex-shrink: 0;
  min-width: 92rpx;
  color: #A7472D;
  font-size: 25rpx;
  font-weight: 900;
  text-align: right;
}

.checkin-panel {
  margin-top: 24rpx;
  padding: 42rpx 30rpx;
  text-align: center;
}

.checkin-date {
  color: #607F7A;
  font-size: 25rpx;
  font-weight: 700;
}

.checkin-title {
  margin-top: 20rpx;
  color: #193C3A;
  font-size: 42rpx;
  font-weight: 900;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.type-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 16rpx;
  border: 2rpx solid #BFD9D3;
  border-radius: 14rpx;
  background: #FBFFFC;
  color: #315A4E;
  font-size: 25rpx;
  font-weight: 800;
  text-align: center;
}

.type-pill.active {
  border-color: #1D7C78;
  background: #DCEDEA;
  color: #0F6B67;
}

.record-item {
  min-height: 112rpx;
}

.record-status {
  flex-shrink: 0;
  min-width: 86rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #E4F2EF;
  color: #0F6B67;
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
}

.record-empty {
  padding: 34rpx 28rpx;
  border: 2rpx dashed #BFD9D3;
  border-radius: 16rpx;
  background: rgba(251, 255, 252, 0.68);
  color: #607F7A;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}
