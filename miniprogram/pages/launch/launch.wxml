<view class="launch-page">
  <view class="launch-bg-fallback"></view>
  <image class="launch-bg" src="/assets/launch/launch-bg.jpg" mode="aspectFill"></image>
  <view class="launch-shade"></view>

  <view class="launch-content">
    <view class="brand-kicker">{{brandKicker}}</view>
    <view class="brand-title">{{brandTitle}}</view>
    <view class="brand-subtitle">{{brandSubtitle}}</view>

    <view class="progress-card">
      <view class="progress-head">
        <text>{{progressText}}</text>
        <text>{{progress}}%</text>
      </view>
      <view class="progress-track">
        <view class="progress-bar" style="width: {{progress}}%;"></view>
      </view>
      <view class="preload-row">
        <view wx:for="{{steps}}" wx:key="label" class="preload-step {{item.done ? 'done' : ''}}">
          <view class="step-dot"></view>
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
