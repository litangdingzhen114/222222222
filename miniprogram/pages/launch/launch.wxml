<view class="launch-page">
  <view class="launch-bg-fallback"></view>
  <image class="launch-bg" src="/assets/launch/launch-bg.jpg" mode="aspectFill"></image>
  <view class="launch-shade"></view>
  <view class="launch-vignette"></view>
  <view class="launch-lines">
    <view class="line line-a"></view>
    <view class="line line-b"></view>
    <view class="line line-c"></view>
  </view>

  <view class="launch-content">
    <view class="brand-head">
      <view class="brand-wordmark">HAILIN</view>
      <view class="brand-index">01</view>
    </view>

    <view class="brand-block">
      <view class="brand-kicker">{{brandKicker}}</view>
      <view class="brand-title">{{brandTitle}}</view>
      <view class="brand-subtitle">{{brandSubtitle}}</view>
    </view>

    <view class="route-preview">
      <view class="route-track"></view>
      <view wx:for="{{steps}}" wx:key="label" class="route-node {{item.done ? 'done' : ''}}">
        <view class="node-dot"></view>
        <text>{{item.label}}</text>
      </view>
    </view>

    <view class="progress-card">
      <view class="progress-head">
        <view>
          <view class="progress-label">{{progressText}}</view>
          <view class="progress-sub">{{progressSubText}}</view>
        </view>
        <text class="progress-percent">{{progress}}%</text>
      </view>
      <view class="progress-track">
        <view class="progress-bar" style="width: {{progress}}%;"></view>
      </view>
      <view class="launch-footnote">正在同步首页、地图点位和农品预订数据</view>
    </view>
  </view>
</view>
