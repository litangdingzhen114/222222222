.launch-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #0D332F;
  color: #FBFFFC;
}

.launch-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.launch-shade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(10, 42, 39, 0.28), rgba(9, 38, 34, 0.9));
}

.launch-content {
  position: relative;
  z-index: 1;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  justify-content: flex-end;
  padding: 120rpx 44rpx 160rpx;
}

.brand-kicker {
  margin-top: 34rpx;
  color: #D8EDE8;
  font-size: 24rpx;
  font-weight: 800;
}

.brand-title {
  margin-top: 12rpx;
  max-width: 620rpx;
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: 0;
  line-height: 1.18;
}

.brand-subtitle {
  margin-top: 18rpx;
  max-width: 620rpx;
  color: rgba(251, 255, 252, 0.86);
  font-size: 27rpx;
  line-height: 1.55;
}

.progress-card {
  margin-top: 58rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(251, 255, 252, 0.24);
  border-radius: 22rpx;
  background: rgba(251, 255, 252, 0.12);
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #FBFFFC;
  font-size: 24rpx;
  font-weight: 800;
}

.progress-track {
  height: 10rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(251, 255, 252, 0.18);
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #F0C765;
  transition: width 180ms ease;
}

.preload-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.preload-step {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 8rpx;
  color: rgba(251, 255, 252, 0.72);
  font-size: 21rpx;
  font-weight: 700;
}

.step-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(251, 255, 252, 0.35);
}

.preload-step.done {
  color: #FBFFFC;
}

.preload-step.done .step-dot {
  background: #F0C765;
}
