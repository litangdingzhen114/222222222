<view wx:if="{{spot}}" class="page spot-detail-page safe-bottom">
  <swiper class="place-hero" indicator-dots="{{true}}" indicator-color="rgba(255,253,248,0.42)" indicator-active-color="#FBFFFC">
    <swiper-item wx:for="{{heroImages}}" wx:key="key">
      <view class="place-hero-slide {{item.imageClass}}">
        <image wx:if="{{item.url}}" class="place-hero-img" src="{{item.url}}" mode="aspectFill"></image>
        <view class="place-hero-mask"></view>
        <view class="place-hero-copy">
          <view class="place-kicker">{{spot.kicker}}</view>
          <view class="place-name">{{spot.name}}</view>
          <view class="place-lead">{{spot.lead}}</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="detail-content">
    <view class="arrival-card">
      <view class="arrival-left">
        <view class="arrival-label">到访信息</view>
        <view class="arrival-mood">{{spot.mood}}</view>
      </view>
      <view class="arrival-distance">{{spot.distance}}</view>
    </view>

    <view class="stat-grid">
      <view wx:for="{{spot.stats}}" wx:key="label" class="stat-card">
        <view class="stat-label">{{item.label}}</view>
        <view class="stat-value">{{item.value}}</view>
      </view>
    </view>

    <view class="story-panel">
      <view class="section-heading">
        <view class="section-mark"></view>
        <text>这里值得停下</text>
      </view>
      <view wx:for="{{spot.story}}" wx:key="*this" class="story-copy">{{item}}</view>
    </view>

    <view class="experience-panel">
      <view class="section-heading">
        <view class="section-mark"></view>
        <text>亮点玩法</text>
      </view>
      <view class="experience-grid">
        <view wx:for="{{spot.experience}}" wx:key="title" class="experience-card">
          <view class="experience-title">{{item.title}}</view>
          <view class="experience-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{heroImages.length > 1}}" class="gallery-strip">
      <view wx:for="{{heroImages}}" wx:key="key" wx:if="{{index > 0}}" class="gallery-item {{item.imageClass}}">
        <image wx:if="{{item.url}}" class="gallery-img" src="{{item.url}}" mode="aspectFill"></image>
      </view>
    </view>

    <view class="detail-itinerary">
      <view class="section-heading">
        <view class="section-mark"></view>
        <text>到访节奏</text>
      </view>
      <view wx:for="{{spot.itinerary}}" wx:key="title" class="timeline-item">
        <view class="timeline-time">{{item.time}}</view>
        <view class="timeline-copy">
          <view class="timeline-title">{{item.title}}</view>
          <view class="timeline-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{spot.visitTips && spot.visitTips.length}}" class="notice-panel">
      <view class="notice-title">到访建议</view>
      <view wx:for="{{spot.visitTips}}" wx:key="*this" class="notice-row">{{item}}</view>
    </view>

    <view wx:if="{{spot.services && spot.services.length}}" class="service-panel service-panel-editorial">
      <view class="service-panel-line service-panel-line-a"></view>
      <view class="service-panel-line service-panel-line-b"></view>
      <view class="service-head">
        <view class="section-heading service-heading">
          <view class="section-mark"></view>
          <text>服务衔接</text>
        </view>
        <view class="service-badge">下一站</view>
      </view>
      <view class="service-subtitle">把这段停留，接成下一步安排</view>
      <view class="service-stack">
        <view
          wx:for="{{spot.services}}"
          wx:key="title"
          class="service-link service-link-{{index}}"
          data-url="{{item.url}}"
          data-open-type="{{item.openType}}"
          bindtap="onServiceTap"
          hover-class="service-link-hover"
          hover-stay-time="90"
        >
          <view class="service-link-no">0{{index + 1}}</view>
          <view class="service-link-copy">
            <view class="service-link-title">{{item.title}}</view>
            <view class="service-link-desc">{{item.desc}}</view>
          </view>
          <view class="service-link-action">
            <text>去安排</text>
            <text class="service-link-arrow">↗</text>
          </view>
        </view>
      </view>
    </view>

    <view class="nearby-panel">
      <view class="section-heading">
        <view class="section-mark"></view>
        <text>顺路看看</text>
      </view>
      <view class="nearby-row">
        <view wx:for="{{nearby}}" wx:key="id" class="nearby-card" data-id="{{item.id}}" bindtap="onNearbyTap">
          <view class="nearby-img {{item.images[0]}}">
            <image wx:if="{{item.coverUrl}}" class="nearby-photo" src="{{item.coverUrl}}" mode="aspectFill"></image>
          </view>
          <view class="nearby-title">{{item.name}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="bottom-mini {{favorite ? 'active' : ''}}" bindtap="onFavorite">{{favorite ? '已收藏' : '收藏'}}</button>
    <button class="bottom-mini" bindtap="onAudioGuide">问小林</button>
    <button class="bottom-main" bindtap="onNavigate">导航前往</button>
  </view>
</view>

<view wx:elif="{{developing}}" class="page developing-page">
  <view class="developing-card">
    <view class="developing-title">更多介绍即将更新</view>
    <view class="developing-copy">该点位资料正在整理，可先查看地图位置、路线推荐或咨询游客服务。</view>
  </view>
</view>
