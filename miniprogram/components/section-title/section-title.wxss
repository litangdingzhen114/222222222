.section-title {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 44rpx 0 22rpx;
}

.title-left {
  display: flex;
  align-items: flex-start;
  min-width: 0;
}

.title-mark {
  flex: 0 0 8rpx;
  width: 8rpx;
  height: 36rpx;
  margin: 6rpx 16rpx 0 0;
  border-radius: 999rpx;
  background: #0F6B67;
}

.title-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.title-text,
.title-subtitle {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.title-text {
  color: #0F4F4B;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 0;
}

.title-subtitle {
  margin-top: 8rpx;
  color: #6B817D;
  font-size: 22rpx;
  line-height: 1.25;
}

.title-more {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-height: 46rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(251, 255, 252, 0.72);
  color: #607F7A;
  font-size: 24rpx;
  line-height: 1;
}

.more-arrow {
  margin-left: 4rpx;
  color: #0F6B67;
  font-size: 32rpx;
}
